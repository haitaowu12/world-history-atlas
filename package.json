{
  "name": "world-history-atlas",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "\u666e\u5929\u4e4b\u4e0b \u00b7 A bilingual atlas for putting history stories in their wider world.",
  "license": "MIT",
  "scripts": {
    "build:content": "node scripts/build-content-expansion-v17.mjs",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node --test --experimental-test-isolation=none tests/*.test.mjs",
    "serve": "python3 scripts/serve.py",
    "build:regions": "node scripts/build-regional-reference.mjs",
    "publish:pages": "npm run check && python3 scripts/publish-pages.py",
    "build:visuals": "node scripts/build-visual-expansion-v18.mjs",
    "check:visual-target": "node scripts/build-visual-expansion-v18.mjs --require-target"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Tony Wu",
  "repository": {
    "type": "git",
    "url": "https://github.com/haitaowu12/world-history-atlas.git"
  },
  "homepage": "https://world-history-atlas-guide.web.app/",
  "bugs": {
    "url": "https://github.com/haitaowu12/world-history-atlas/issues"
  }
}
